// prisma/schema/tickets.prisma

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  SUPPORT
  INCIDENT
  REQUEST
  QUESTION
  COMPLAINT
}

enum TicketVisibility {
  INTERNAL
  CUSTOMER
}

model Ticket {
  id             String  @id @default(uuid())
  organizationId String?
  creatorId      String
  assigneeId     String?
  projectId      String?

  // فیلدهای حرفه‌ای منطبق بر Case در مایکروسافت داینامیکس
  accountId       String? // شرکت/سازمان طرف حساب
  contactId       String? // شخص مخاطب ثبت‌کننده
  parentTicketId  String? // برای ادغام تیکت‌ها (Parent/Child Case)
  resolution      String? // شرح راه‌حل نهایی ارائه‌شده
  billableHours   Decimal?  @db.Decimal(5, 2) // ساعات کاری صرف‌شده
  targetResolveAt DateTime? // زمان مهلت رفع مشکل بر اساس SLA
  resolvedAt      DateTime?
  closedAt        DateTime?

  ticketNumber Int
  subject      String
  description  String
  type         TicketType       @default(SUPPORT)
  status       TicketStatus     @default(OPEN)
  priority     TicketPriority   @default(MEDIUM)
  visibility   TicketVisibility @default(INTERNAL)
  category     String?
  dueAt        DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User          @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // رابطه درختی تیکت مادر و فرزند (Parent-Child)
  parentTicket Ticket?  @relation("TicketToTicket", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets Ticket[] @relation("TicketToTicket")

  messages TicketMessage[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([projectId])
  @@index([accountId])
  @@index([contactId])
  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_messages")
}
