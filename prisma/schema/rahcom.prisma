model RahcomSystem {
  id                String           @id @default(cuid())
  organizationId    String
  province          String           @db.VarChar(80)
  systemName        String           @db.VarChar(200)
  systemCode        String           @db.VarChar(100)
  axis              String?          @db.VarChar(120)
  axisCode          String?          @db.VarChar(100)
  incidentType      String?          @db.VarChar(24)
  incidentDetails   String?          @db.VarChar(1000)
  latitude          Float
  longitude         Float
  details           String?
  electricityBillId String?          @db.VarChar(120)
  simIp             String?          @db.VarChar(100)
  radarIp           String?          @db.VarChar(100)
  cameraIp          String?          @db.VarChar(100)
  pcIp              String?          @db.VarChar(100)
  routerIp          String?          @db.VarChar(100)
  laptopIp          String?          @db.VarChar(100)
  activities        RahcomActivity[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, province, systemCode])
  @@index([organizationId, province])
  @@map("rahcom_systems")
}

model RahcomAxis {
  id             String       @id @default(cuid())
  organizationId String
  province       String       @db.VarChar(80)
  name           String       @db.VarChar(120)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, province, name])
  @@index([organizationId, province])
  @@map("rahcom_axes")
}

model RahcomActivity {
  id                 String        @id @default(cuid())
  organizationId     String
  createdById        String
  systemId           String?
  systemNameSnapshot String?       @db.VarChar(200)
  systemCodeSnapshot String?       @db.VarChar(100)
  provinceSnapshot   String?       @db.VarChar(80)
  activityDate       DateTime      @db.Date
  activityType       String        @db.VarChar(40)
  quantity           Int           @default(1)
  description        String?       @db.VarChar(1000)
  accompaniedBy      String?       @db.VarChar(200)
  handedOverTo       String?       @db.VarChar(200)
  performedBy        String?       @db.VarChar(200)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  system             RahcomSystem? @relation(fields: [systemId], references: [id], onDelete: SetNull)

  @@index([organizationId, activityDate])
  @@index([organizationId, systemId, activityDate])
  @@map("rahcom_activities")
}

model RahcomSolarSnapshot {
  id               String       @id @default(cuid())
  organizationId   String
  createdById      String
  province         String?      @db.VarChar(80)
  capturedAt       DateTime     @default(now())
  downText         String       @db.Text
  unreachableText  String       @db.Text
  equipmentColumns String[]     @default([])
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, capturedAt])
  @@index([organizationId, province, capturedAt])
  @@map("rahcom_solar_snapshots")
}

model RahcomSolarSpecialSystem {
  id             String       @id @default(cuid())
  organizationId String
  province       String       @db.VarChar(80)
  systemCode     String       @db.VarChar(100)
  category       String       @db.VarChar(32)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, province, systemCode])
  @@index([organizationId, province])
  @@map("rahcom_solar_special_systems")
}

model RahcomTrafficSnapshot {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  fileName       String       @db.VarChar(255)
  sheetName      String       @db.VarChar(120)
  headers        Json         @db.JsonB
  rows           Json         @db.JsonB
  rowCount       Int
  snapshotDate   DateTime     @db.Date
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, snapshotDate, createdAt])
  @@map("rahcom_traffic_snapshots")
}

model RahcomImportedTicket {
  id             String       @id @default(cuid())
  organizationId String
  ticketCode     String       @db.VarChar(100)
  systemCode     String       @default("") @db.VarChar(100)
  province       String?      @db.VarChar(80)
  listDate       DateTime     @db.Date
  summary        String       @db.Text
  customer       String       @default("") @db.Text
  equipment      String       @default("") @db.Text
  type           String       @default("") @db.VarChar(120)
  status         String       @default("") @db.VarChar(120)
  priority       String       @default("") @db.VarChar(120)
  supportTeam    String       @default("") @db.VarChar(200)
  createdOn      String       @default("") @db.VarChar(120)
  sourceFileName String       @db.VarChar(255)
  importedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, province, listDate, ticketCode])
  @@index([organizationId, systemCode])
  @@index([organizationId, province])
  @@index([organizationId, province, listDate])
  @@index([organizationId, importedAt])
  @@map("rahcom_imported_tickets")
}

model RahcomRoadList {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  province       String       @db.VarChar(80)
  fileName       String       @db.VarChar(255)
  sheetName      String       @db.VarChar(120)
  headers        Json         @db.JsonB
  rows           Json         @db.JsonB
  rowCount       Int
  listDate       DateTime     @db.Date
  importedAt     DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, province, listDate])
  @@index([organizationId, importedAt])
  @@map("rahcom_road_lists")
}
