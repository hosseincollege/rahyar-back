# Local PostgreSQL connection. Replace CHANGE_ME with the password for your local postgres role.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rahyar_dev?schema=public"

# Generate a private random value for JWT_SECRET; keep it out of source control.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="86400"
PORT="3016"

# Organization slug authorized to receive the initial Isfahan invoice workbook
RAHCOM_INVOICE_SEED_ORGANIZATION_SLUG=rahyar

# Invoice attachment files are kept outside the frontend and backend source folders.
RAHYAR_STORAGE_ROOT="../Rahyar Storage"
