# Local PostgreSQL connection. Replace CHANGE_ME with the password for your local postgres role.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rahyar_dev?schema=public"

# Generate a private random value for JWT_SECRET; keep it out of source control.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="86400"
PORT="3016"
